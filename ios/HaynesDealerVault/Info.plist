	<!-- PRIVACY PERMISSIONS - CAMERA -->
	<key>NSCameraUsageDescription</key>
	<string>We need camera access to scan barcodes and QR codes on parts packages and in repair shops. You can deny this and manually search instead.</string>

	<!-- PRIVACY PERMISSIONS - LOCATION -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We use your location to find nearby parts suppliers and repair shops. Location data is never stored or shared with third parties. You can disable this in Settings.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>We use your location to find nearby parts suppliers and repair shops. Location data is never stored or shared with third parties. You can disable this in Settings.</string>

	<key>NSLocationAlwaysUsageDescription</key>
	<string>We use your location to find nearby parts suppliers and repair shops. Location data is never stored or shared with third parties. You can disable this in Settings.</string>

	<!-- PRIVACY PERMISSIONS - PHOTO LIBRARY (for repair photos) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need photo library access to let you upload repair photos and documentation. You can deny this and use the camera instead.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>We need to save repair photos and documentation to your photo library. You can deny this and save manually instead.</string>

	<!-- PRIVACY PERMISSIONS - MICROPHONE (for video documentation) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>We need microphone access for video documentation of repairs. You can deny this and use photos instead.</string>

	<!-- PRIVACY PERMISSIONS - CONTACTS (optional, for support) -->
	<key>NSContactsUsageDescription</key>
	<string>We request access to your contacts to help you quickly share repair information with mechanics. You can deny this and enter details manually.</string>

	<!-- PRIVACY PERMISSIONS - CALENDAR (optional, for scheduling) -->
	<key>NSCalendarsUsageDescription</key>
	<string>We can help you schedule repair appointments. You can deny this and manage your calendar manually.</string>

	<!-- SECURITY: Local Network Access -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>We may need to connect to devices on your local network for diagnostic tools. You can deny this.</string>

	<key>NSBonjourServiceTypes</key>
	<array>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
	</array>

